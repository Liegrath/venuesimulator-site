{%- set pageTitle = (title + " · " + site.title) if title else (site.title + " — a festival and venue management game") -%}
{%- set pageDesc = description or site.tagline -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} devlog" href="/feed.xml">
  <meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ image or '/assets/img/og.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/assets/fonts/BlueprintSketch.otf" as="font" type="font/otf" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
  <header class="top">
    <div class="wrap top-in">
      <a class="brand" href="/" aria-label="Venue Simulator home">Venue Simulator</a>
      <nav class="nav">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Game</a>
        <a href="/blog/"{% if page.url.startsWith("/blog/") %} aria-current="page"{% endif %}>Devlog</a>
        {% include "steam-button.njk" %}
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <span class="brand brand-sm">Venue Simulator</span>
      <span>An indie management game in development. © {{ build.year }} {{ site.author }}.</span>
      <a href="/feed.xml">RSS</a>
    </div>
  </footer>
</body>
</html>
