---
layout: base.njk
title: Devlog
description: The development blog of Venue Simulator, a music festival management game. New features, screenshots and lessons from making my first game.
---
<section class="wrap narrow">
  <header class="page-head">
    <h1>Devlog</h1>
    <p class="lede">{{ description }}</p>
  </header>
  <ul class="post-list post-list-full">
    {%- for post in collections.posts %}
    <li>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | niceDate }}</time>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
      {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    </li>
    {%- endfor %}
  </ul>
</section>
